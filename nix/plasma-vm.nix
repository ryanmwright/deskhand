# Plasma 6 Wayland test VM for Deskhand development (`just vm`, `nix run .#plasma-vm`).
#
# - SDDM logs user `dev` (password `dev`) straight into a Plasma Wayland session.
# - The repository is shared at /mnt/deskhand (9p). The `deskhand-dev` user service runs
#   /mnt/deskhand/target/debug/deskhand with dev/vm/config.toml, which points at the dev
#   broker on the host (10.0.2.2:1883). Build on the host, then in the VM:
#   `systemctl --user restart deskhand-dev`. The host's /nix/store is shared, so a binary
#   built in `nix develop` on the host runs unchanged.
# - ssh: `ssh -p 2222 -i dev/vm/ssh/id_ed25519 dev@127.0.0.1` (key generated by the launcher,
#   port bound to the host's loopback only). `just vm-ssh` does this.
#
# Development only: fixed passwords, passwordless sudo, no firewall.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:
let
  workspace = "/mnt/deskhand";
in
{
  imports = [ "${modulesPath}/virtualisation/qemu-vm.nix" ];

  system.stateVersion = "26.05";
  networking.hostName = "plasma-vm";

  virtualisation = {
    memorySize = 4096;
    cores = 4;
    diskSize = 8192;
    graphics = true;
    # virtio-gpu without host GL: works on any host display (and headless with
    # QEMU_OPTS="-display none"). Plasma falls back to software rendering.
    qemu.options = [
      "-vga none"
      "-device virtio-vga"
    ];
    forwardPorts = [
      {
        from = "host";
        host.address = "127.0.0.1";
        host.port = 2222;
        guest.port = 22;
      }
    ];
    # The launcher exports DESKHAND_WORKSPACE (the repository root).
    sharedDirectories.deskhand = {
      source = ''"$DESKHAND_WORKSPACE"'';
      target = workspace;
    };
  };

  services.desktopManager.plasma6.enable = true;
  services.displayManager = {
    sddm = {
      enable = true;
      wayland.enable = true;
    };
    defaultSession = "plasma";
    autoLogin = {
      enable = true;
      user = "dev";
    };
  };

  # Same uid as the usual host user, so files written to the share keep sensible owners.
  users.users.dev = {
    isNormalUser = true;
    uid = 1000;
    password = "dev";
    extraGroups = [
      "wheel"
      "video"
      "audio"
    ];
  };
  security.sudo.wheelNeedsPassword = false;

  services.openssh = {
    enable = true;
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
    };
  };
  # The launcher generates a key pair in dev/vm/ssh; authorise its public half at boot.
  systemd.services.deskhand-dev-ssh-key = {
    description = "Authorise the Deskhand dev ssh key";
    wantedBy = [ "multi-user.target" ];
    before = [ "sshd.service" ];
    unitConfig.RequiresMountsFor = workspace;
    serviceConfig.Type = "oneshot";
    script = ''
      key=${workspace}/dev/vm/ssh/id_ed25519.pub
      if [ -f "$key" ]; then
        install -d -m 700 -o dev -g users /home/dev/.ssh
        install -m 600 -o dev -g users "$key" /home/dev/.ssh/authorized_keys
      fi
    '';
  };

  # Deskhand from the shared host build. Only starts once a binary exists.
  systemd.user.services.deskhand-dev = {
    description = "Deskhand (development build from the host)";
    partOf = [ "graphical-session.target" ];
    after = [ "graphical-session.target" ];
    wantedBy = [ "graphical-session.target" ];
    unitConfig.ConditionPathExists = "${workspace}/target/debug/deskhand";
    serviceConfig = {
      Type = "notify";
      ExecStart = "${workspace}/target/debug/deskhand --config ${workspace}/dev/vm/config.toml run";
      Restart = "on-failure";
      RestartSec = 5;
    };
  };

  environment.systemPackages = with pkgs; [
    kdePackages.kscreen # kscreen-doctor (DPMS, outputs)
    kdePackages.qttools # qdbus
    libnotify
    pulseaudio # pactl against PipeWire's pulse server
    mosquitto
    jq
    # Plays lavfi test video (idle while video plays) and audio; the mpris script
    # makes it an MPRIS player for the media integration.
    (mpv.override { scripts = [ mpvScripts.mpris ]; })
    v4l-utils
    wireplumber # wpctl
  ];

  # A fake camera (/dev/video0) for the camera_in_use probe and tests.
  boot.extraModulePackages = [ config.boot.kernelPackages.v4l2loopback ];
  boot.kernelModules = [ "v4l2loopback" ];
  boot.extraModprobeConfig = ''
    options v4l2loopback devices=1 video_nr=0 card_label="Deskhand test camera" exclusive_caps=1
  '';

  services.pipewire = {
    enable = true;
    pulse.enable = true;
  };
  hardware.bluetooth.enable = true;
  services.power-profiles-daemon.enable = true;
  services.upower.enable = true;

  # QEMU's S3 suspend hangs the guest on resume (virtio devices); s2idle
  # ("freeze") resumes reliably. Wake it with the QEMU monitor (`sendkey`
  # or `system_wakeup`).
  systemd.sleep.settings.Sleep.SuspendState = "freeze";

  networking.firewall.enable = false;
  documentation.enable = false;
  # Keep the VM quick to build and boot.
  boot.loader.timeout = lib.mkDefault 0;
  services.xserver.xkb.layout = "us";
  time.timeZone = "UTC";
  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];
}
